# Variáveis do docker-compose.yml (raiz) — cp pra .env antes de "docker compose up".
# Isso é separado de backend/.env.example, que continua servindo o fluxo sem Docker.

# Porta do host que o nginx publica (http://localhost:HTTP_PORT).
HTTP_PORT=80

# Postgres (container "postgres" do compose)
POSTGRES_USER=belfrango
POSTGRES_PASSWORD=gere-uma-senha-forte
POSTGRES_DB=bel_do_frango_atu

# Repassadas pro backend (mesmas do backend/.env.example — ver lá o
# significado de cada uma).
JWT_SECRET=gere-com-openssl-rand-base64-48
NODE_ENV=production
FRONTEND_URL=http://localhost
DOMINIO_BASE=
TENANT_DEV_PADRAO=
ENTREGADOR_NOME="Equipe de entrega"
ENTREGADOR_TELEFONE=""
TAXA_ENTREGA=7.9

# Obrigatórias em produção (NODE_ENV=production) — sem elas "npm run db:seed" aborta.
SEED_ADMIN_SENHA=
SEED_GARCOM_SENHA=
SEED_ATENDENTE_SENHA=
SEED_SUPER_EMAIL=
SEED_SUPER_SENHA=
