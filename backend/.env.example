DATABASE_URL="postgresql://usuario:senha@localhost:5432/bel_do_frango_atu"
PORT=3010
JWT_SECRET="gere-com-openssl-rand-base64-48"
FRONTEND_URL=http://127.0.0.1:5000
NODE_ENV=development
# Tenant usado quando não há header x-tenant-slug nem subdomínio real (abrir o
# app direto no navegador em localhost). Só lido em NODE_ENV=development.
TENANT_DEV_PADRAO=belfrango
# Domínio raiz da plataforma em produção (ex: "dominio.com") — o CORS dinâmico
# (Fase 5) só aceita origens "https://<subdominio>.<DOMINIO_BASE>". Sem isso
# configurado, só as origens de dev (localhost/127.0.0.1) funcionam.
DOMINIO_BASE=
ENTREGADOR_NOME="Equipe de entrega"
ENTREGADOR_TELEFONE=""
TAXA_ENTREGA=7.9
GAME_JWT_SECRET="saas_pipes_internal_secure_hmac_secret_2026"

# Evolution API (WhatsApp self-hosted, ver docker-compose.yml na raiz) — usado
# pra confirmação de pedido no WhatsApp do cliente (1 instância por tenant).
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=gere-uma-chave-forte

# Obrigatorias em producao (NODE_ENV=production) — sem elas o "npm run db:seed" aborta.
# Em dev podem ficar vazias: o seed usa uma senha padrao só para uso local.
SEED_ADMIN_SENHA=
SEED_GARCOM_SENHA=
SEED_ATENDENTE_SENHA=
SEED_SUPER_EMAIL=
SEED_SUPER_SENHA=
