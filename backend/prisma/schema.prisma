// Schema do backend do protótipo Bel do Frango ATU.
// Multitenant row-level (1 banco, coluna tenantId) — resolução de tenant por
// subdomínio (fases seguintes). Banco e processo próprios (bel_do_frango_atu).
// Portado do backend "Bel do frango" original e estendido com o catálogo de
// "Monte sua marmita" (proteínas/complementos/tamanhos) e foto de produto.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoCupom {
  PERCENTUAL
  FRETE_GRATIS
}

enum StatusEntrega {
  CONFIRMADO
  PREPARANDO
  SAIU_ENTREGA
  ENTREGUE
  CANCELADO
}

enum CtaBanner {
  CARDAPIO
  PRODUTO
}

enum FormaPagamento {
  PIX
  CARTAO
  DINHEIRO
}

enum TipoPedido {
  ENTREGA
  MESA
  RETIRADA
  EMPRESA
}

enum StatusMesa {
  LIVRE
  OCUPADA
  RESERVADA
  CONTA
}

/// Ramo de negócio do tenant — decide qual variação de tela/campo o Admin
/// mostra (ex: código de barras e custo só fazem sentido pra MERCANTIL).
/// RESTAURANTE é o default: todo tenant existente hoje continua exatamente
/// como está, sem precisar de migration de dado nenhuma.
enum TipoTenant {
  RESTAURANTE
  MERCANTIL
}

/// Uma loja/tenant do sistema, resolvida pelo subdomínio (ex: "belfrango" ->
/// belfrango.dominio.com). Todo o resto do schema é escopado por tenantId.
model Tenant {
  id       String     @id @default(uuid())
  slug     String     @unique // "belfrango" -> belfrango.dominio.com
  nome     String
  tipo     TipoTenant @default(RESTAURANTE)
  ativo    Boolean    @default(true)
  criadoEm DateTime   @default(now())

  configuracao        Configuracao?
  admins              Admin[]
  garcons             Garcom[]
  atendentes          Atendente[]
  categorias          CategoriaProduto[]
  subcategorias       Subcategoria[]
  produtos            Produto[]
  adicionais          Adicional[]
  cupons              Cupom[]
  clientes            Cliente[]
  pedidos             Pedido[]
  itensPedido         ItemPedido[]
  proteinas           Proteina[]
  complementos        Complemento[]
  tamanhosMarmita     TamanhoMarmita[]
  banners             Banner[]
  mesas               Mesa[]
  caixas              Caixa[]
  empresas            Empresa[]
  empresaFuncionarios EmpresaFuncionario[]
  entregadores        Entregador[]
  sangriasEntregador  SangriaEntregador[]
  bairros             Bairro[]
  avaliacoesProduto   AvaliacaoProduto[]

  // Fase 6A — Super Admin
  branding            TenantBranding?
  features            TenantFeature[]
  impersonacaoCodigos ImpersonacaoCodigo[]
  logsImpersonacao    LogImpersonacao[]
  catalogoProdutos    CatalogoProdutoTenant[]
}

/// Configurações gerais da loja — 1 registro por tenant. `taxaEntrega` aqui é
/// o padrão pra "Outro bairro"/bairros não cadastrados (ver model Bairro) —
/// antes vivia fixa no .env, sem o admin poder mudar sem reiniciar o servidor.
model Configuracao {
  id                   Int      @id @default(autoincrement())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxaEntrega          Float    @default(7.9)
  /// Janela de horário de retirada pra produtos da categoria Galetos (formato "HH:MM").
  /// A lista de horários de 30 em 30 min é gerada a partir desses dois campos, nunca salva pronta.
  galetoHorarioInicio  String   @default("10:00")
  galetoHorarioFim     String   @default("20:00")
  /// Horário de funcionamento da loja, por dia da semana — chaves "dom".."sab",
  /// cada uma com até 2 turnos [{inicio,fim}] em "HH:MM" (turno vazio = fechado
  /// nesse dia). null = sem restrição cadastrada (loja sempre aberta, mesmo
  /// comportamento de antes deste campo existir — ver utils/horarioFuncionamento.js).
  horarioFuncionamento Json?
  /// Endereço completo da loja/estabelecimento exibido nas retiradas no local.
  enderecoLoja         String?  @default("Rua Central, 100 — Centro")
  /// Cidade/UF da loja (ex: "Caucaia - CE") — usado como fallback de cidade no
  /// endereço do cliente quando ele não preenche o CEP no checkout (a cidade só
  /// vem do autofill do CEP hoje). Sem uma cidade no endereço, o Google Maps
  /// geocodifica "Rua 118, 495, Planalto Caucaia" errado (rua numerada é comum
  /// em vários municípios) e o entregador é mandado pro lugar errado.
  cidadeLoja           String?
  capaUrl              String?
  /// Access Token da conta Mercado Pago do PRÓPRIO tenant — nunca compartilhado
  /// entre lojas. Presente = PIX no checkout vira cobrança real (QR Code +
  /// confirmação automática via webhook); ausente = PIX continua só
  /// informativo, como sempre foi (ver pedidoController.criar).
  mercadoPagoAccessToken String?
  /// URL (base64 data URI) do QR Code PIX estático da loja — exibido no PDV
  /// do atendente quando a forma de pagamento PIX é selecionada.
  pixQrCodeUrl         String?
  /// Nome da instância do tenant no Evolution API (self-hosted) — 1 instância
  /// por tenant, criada na primeira vez que o admin conecta o WhatsApp.
  whatsappInstancia    String?
  /// Token (apikey) da instância, devolvido pelo Evolution API na criação —
  /// só serve pra mandar mensagem por ESSA instância, nunca é exposto ao
  /// painel (mesmo racional do mercadoPagoAccessToken).
  whatsappToken        String?
  /// true depois que o QR Code foi escaneado e a sessão do WhatsApp está ativa.
  whatsappConectado    Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

/// Bairro cadastrado pela loja com sua própria taxa de entrega — o cliente
/// escolhe um logo depois do splash (ver index.html) e essa taxa substitui o
/// `Configuracao.taxaEntrega` padrão pro pedido dele. "Outro bairro" (não
/// cadastrado aqui) continua usando o padrão.
model Bairro {
  id          Int      @id @default(autoincrement())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome        String
  taxaEntrega Float
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([tenantId, nome])
  @@index([tenantId])
}

/// Usuario do painel administrativo (cozinha/gestao da galeteria).
model Admin {
  id              Int       @id @default(autoincrement())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String
  senha           String
  nome            String
  /// Marca a ultima troca de senha — o middleware rejeita tokens JWT emitidos
  /// antes dessa data (sessoes antigas nao ficam validas apos a troca).
  senhaAlteradaEm DateTime?
  createdAt       DateTime  @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

/// Garçom — login próprio, separado do Admin. Acesso restrito à tela de
/// salão (mesas + cardápio pra anotar pedido), nunca ao painel completo.
model Garcom {
  id              Int       @id @default(autoincrement())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String
  senha           String
  nome            String
  ativo           Boolean   @default(true)
  /// Marca a ultima troca de senha — o middleware rejeita tokens JWT emitidos
  /// antes dessa data (sessoes antigas nao ficam validas apos a troca).
  senhaAlteradaEm DateTime?
  createdAt       DateTime  @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

/// Atendente de balcão — login próprio, separado do Admin. Acesso restrito à
/// tela de criar pedido manual (retirada), nunca ao painel completo.
model Atendente {
  id              Int       @id @default(autoincrement())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String
  senha           String
  nome            String
  ativo           Boolean   @default(true)
  /// Marca a ultima troca de senha — o middleware rejeita tokens JWT emitidos
  /// antes dessa data (sessoes antigas nao ficam validas apos a troca).
  senhaAlteradaEm DateTime?
  createdAt       DateTime  @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

model CategoriaProduto {
  id            Int            @id @default(autoincrement())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome          String
  ordem         Int            @default(0)
  /// Caminho relativo do arquivo em /uploads/categorias (ex: "categorias/abc123.jpg") — nunca base64 no banco.
  foto          String?
  produtos      Produto[]
  subcategorias Subcategoria[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([tenantId, nome])
  @@index([tenantId])
}

/// Subdivisão opcional de uma categoria (ex: dentro de "Bebidas" — Cervejas,
/// Água, Refrigerante, Água de Coco). Produto.subcategoriaId é opcional —
/// uma categoria sem subcategorias cadastradas simplesmente não usa isso.
model Subcategoria {
  id          Int              @id @default(autoincrement())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome        String
  ordem       Int              @default(0)
  categoriaId Int
  categoria   CategoriaProduto @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  produtos    Produto[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, categoriaId, nome])
  @@index([tenantId])
}

model Produto {
  id                Int              @id @default(autoincrement())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoriaId       Int
  categoria         CategoriaProduto @relation(fields: [categoriaId], references: [id])
  subcategoriaId    Int?
  subcategoria      Subcategoria?    @relation(fields: [subcategoriaId], references: [id], onDelete: SetNull)
  nome              String
  descricaoCurta    String
  descricaoCompleta String
  /// Fonte unica de verdade do preco — nunca aceito do corpo da requisicao ao criar pedido.
  preco             Float
  /// Só usado por tenant MERCANTIL (margem = preco - custo) — null pro resto.
  custo             Float?
  /// Só usado por tenant MERCANTIL (leitor de código de barras no PDV) — null pro resto.
  /// Único por tenant quando preenchido (dois produtos não podem ter o mesmo código).
  codigoBarras      String?
  /// Média das notas de AvaliacaoProduto — denormalizada (recalculada a cada
  /// avaliação nova, ver pedidoController.avaliar) pra não agregar toda vez
  /// que o cardápio carrega, que é caminho quente.
  avaliacao         Float?
  tag               String?
  /// Caminho relativo do arquivo em /uploads/produtos (ex: "produtos/abc123.jpg") — nunca base64 no banco.
  foto              String?
  estoque           Int              @default(0)
  destaque          Boolean          @default(false)
  ativo             Boolean          @default(true)
  /// "Prato do dia" do canal empresa — só produtos marcados aqui aparecem no
  /// cardápio restrito que a empresa (cliente corporativo) vê pra pedir.
  disponivelEmpresa Boolean          @default(false)
  /// Quando true, `preco` vira preço por KG (não por unidade) — quem compra
  /// informa o peso em gramas, que fica gravado em ItemPedido.quantidade
  /// (ver montarItemValidado em pedidoController.js).
  vendidoPorPeso    Boolean          @default(false)
  itensPedido       ItemPedido[]
  banners           Banner[]
  /// Adicionais pagos próprios deste produto (ex: "Bacon +R$3" só no Galeto) —
  /// cadastrados e editados direto no modal do produto, nunca compartilhados entre produtos.
  adicionais        Adicional[]
  avaliacoes        AvaliacaoProduto[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([tenantId, codigoBarras])
  @@index([tenantId])
  @@index([categoriaId])
  @@index([subcategoriaId])
}

/// Catálogo mestre de produtos, curado pelo super admin a partir de produtos
/// já cadastrados em algum tenant ("promover" — ver superCatalogoController).
/// Não pertence a nenhum tenant (por isso fica em MODELS_NAO_ESCOPADOS em
/// prismaTenant.js). Importar pra um tenant (ver catalogoProdutoController)
/// só copia os dados pra um Produto novo — sem vínculo depois, editar aqui
/// não afeta quem já importou.
model ProdutoCatalogo {
  id                Int      @id @default(autoincrement())
  nome              String
  descricaoCurta    String
  descricaoCompleta String
  preco             Float?
  codigoBarras      String?
  /// Caminho relativo em /uploads/catalogo/produtos — cópia independente da
  /// foto do produto de origem, nunca referencia o arquivo do tenant original.
  foto              String?
  tag               String?
  criadoEm          DateTime @default(now())
  tenants           CatalogoProdutoTenant[]
}

/// Libera um item do catálogo mestre pra um tenant específico — só o super
/// admin cria/remove essas linhas (painel super). A existência da linha é
/// a própria permissão: sem "ativo" boolean, só existe ou não.
model CatalogoProdutoTenant {
  id                Int             @id @default(autoincrement())
  catalogoProdutoId Int
  catalogoProduto   ProdutoCatalogo @relation(fields: [catalogoProdutoId], references: [id], onDelete: Cascade)
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  criadoEm          DateTime        @default(now())

  @@unique([catalogoProdutoId, tenantId])
  @@index([tenantId])
}

/// Nota (1-5) que um cliente dá a um produto depois que o PRÓPRIO pedido dele
/// chegou (statusEntrega=ENTREGUE) — nunca antes disso, e nunca pra produto
/// que não estava no pedido (ver pedidoController.avaliar). Uma linha por
/// combinação pedido+produto — reenviar atualiza a nota (upsert), não duplica.
model AvaliacaoProduto {
  id        Int      @id @default(autoincrement())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pedidoId  Int
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId Int
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nota      Int
  createdAt DateTime @default(now())

  @@unique([pedidoId, produtoId])
  @@index([tenantId])
  @@index([produtoId])
}

/// Adicional pago de um produto específico (ex: "Bacon +R$3" só no Galeto Inteiro).
/// Cada linha pertence a exatamente um produto — sem catálogo compartilhado.
model Adicional {
  id          Int                   @id @default(autoincrement())
  tenantId    String
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  produtoId   Int
  produto     Produto               @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nome        String
  preco       Float
  ativo       Boolean               @default(true)
  esgotado    Boolean               @default(false)
  itensUsados ItemPedidoAdicional[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([tenantId])
  @@index([produtoId])
}

model Cupom {
  id         Int       @id @default(autoincrement())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  codigo     String
  tipo       TipoCupom
  /// Percentual de desconto (0-100) quando tipo = PERCENTUAL; ignorado se FRETE_GRATIS.
  percentual Int?
  ativo      Boolean   @default(true)
  pedidos    Pedido[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, codigo])
  @@index([tenantId])
}

/// Cliente identificado por telefone no checkout (guest checkout, sem senha).
/// Dado pessoal (LGPD): vive só aqui no backend — nunca cacheado no frontend.
model Cliente {
  id             Int      @id @default(autoincrement())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome           String
  telefone       String
  enderecoPadrao Json?
  pedidos        Pedido[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, telefone])
  @@index([tenantId])
}

model Pedido {
  id                   Int             @id @default(autoincrement())
  tenantId             String
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Chave pública pra tela de acompanhamento (guest, sem login) — nunca o id
  /// sequencial, que permitiria enumerar/ver pedidos de outros clientes (IDOR).
  codigoAcompanhamento String          @default(uuid())
  /// ENTREGA (delivery, fluxo padrão) | MESA (comanda de salão) | RETIRADA (balcão).
  tipo                 TipoPedido      @default(ENTREGA)
  clienteId            Int?
  cliente              Cliente?        @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  /// Pedido de mesa não tem cliente identificado (guest) — nomeCliente vira só "Mesa N" se em branco.
  mesaId               Int?
  mesa                 Mesa?           @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  /// Preenchido só quando tipo = EMPRESA — pedido em lote de um cliente
  /// corporativo (construtora etc.), nomeCliente vira o nome do funcionário.
  empresaId            Int?
  empresa              Empresa?        @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  nomeCliente          String
  /// Obrigatorio para ENTREGA; nulo para MESA/RETIRADA.
  telefone             String?
  endereco             Json?
  valorTrocoPara       Float?
  /// Observação geral do pedido (ex: "sem talher, buzinar na chegada") — livre,
  /// diferente das observações por item (essas ficam em ItemPedido).
  observacoes          String?
  itens                ItemPedido[]
  avaliacoes           AvaliacaoProduto[]
  cupomId              Int?
  cupom                Cupom?          @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  /// subtotal/desconto/taxaEntrega/total sao calculados e congelados no servidor na criacao — nunca recebidos prontos do client.
  subtotal             Float
  desconto             Float           @default(0)
  taxaEntrega          Float           @default(0)
  total                Float
  /// Definida na criacao (ENTREGA) ou só no fechamento da conta (MESA).
  formaPagamento       FormaPagamento?
  /// Atualizado manualmente pelo admin (painel) conforme o pedido avanca na cozinha/entrega/mesa.
  statusEntrega        StatusEntrega   @default(CONFIRMADO)
  /// Só false pra PIX criado via Mercado Pago (ver pedidoController.criar) — o
  /// pedido existe (aparece na cozinha) mas o pagamento em si ainda não caiu.
  /// Webhook do MP vira true assim que a API confirma status "approved".
  /// Sempre true pra dinheiro/cartão/PIX sem integração — pago na hora, como já era.
  pagamentoConfirmado  Boolean         @default(true)
  /// Id do pagamento no Mercado Pago — usado pelo webhook pra achar o pedido
  /// certo (nunca confia no valor que vem no corpo do webhook em si, sempre
  /// reconsulta a API do MP com esse id antes de marcar como pago).
  pagamentoExternoId   String?
  /// Marcado uma única vez, no momento em que statusEntrega vira ENTREGUE — usado
  /// pra calcular o saldo em dinheiro do entregador (não usar createdAt/updatedAt pra isso).
  entregueEm           DateTime?
  entregadorId         Int?
  entregador           Entregador?     @relation(fields: [entregadorId], references: [id], onDelete: SetNull)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([tenantId, codigoAcompanhamento])
  @@index([tenantId])
  @@index([entregadorId, statusEntrega, formaPagamento, entregueEm])
}

/// Um item de pedido é OU um produto fixo do cardápio (produtoId preenchido)
/// OU uma marmita montada (tamanhoMarmitaId preenchido, com proteínas/complementos
/// nas tabelas de junção abaixo). O controller garante que só um dos dois é usado.
model ItemPedido {
  id                     Int                     @id @default(autoincrement())
  tenantId               String
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pedidoId               Int
  pedido                 Pedido                  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId              Int?
  produto                Produto?                @relation(fields: [produtoId], references: [id])
  tamanhoMarmitaId       Int?
  tamanhoMarmita         TamanhoMarmita?         @relation(fields: [tamanhoMarmitaId], references: [id])
  proteinas              ItemPedidoProteina[]
  complementos           ItemPedidoComplemento[]
  /// Adicionais escolhidos — só se aplica a item de produto fixo (produtoId), nunca a marmita montada.
  adicionais             ItemPedidoAdicional[]
  quantidade             Int
  observacoes            String?
  /// Preco unitario (do produto OU do tamanho de marmita) no momento do pedido — congelado.
  precoUnitarioCongelado Float

  @@index([tenantId])
  @@index([pedidoId])
}

/// Um adicional escolhido dentro de um item de pedido, com preço e quantidade próprios
/// (ex: 2x Bacon). Preço sempre congelado do catálogo no momento do pedido.
/// Pivot pura (nunca consultada isolada por tenant) — sem tenantId, só via ItemPedido/Adicional.
model ItemPedidoAdicional {
  id                     Int        @id @default(autoincrement())
  itemPedidoId           Int
  itemPedido             ItemPedido @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)
  adicionalId            Int
  adicional              Adicional  @relation(fields: [adicionalId], references: [id])
  quantidade             Int        @default(1)
  precoUnitarioCongelado Float

  @@index([itemPedidoId])
}

/// Pivot pura (nunca consultada isolada por tenant) — sem tenantId, só via ItemPedido/Proteina.
model ItemPedidoProteina {
  id           Int        @id @default(autoincrement())
  itemPedidoId Int
  itemPedido   ItemPedido @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)
  proteinaId   Int
  proteina     Proteina   @relation(fields: [proteinaId], references: [id])

  @@index([itemPedidoId])
}

/// Pivot pura (nunca consultada isolada por tenant) — sem tenantId, só via ItemPedido/Complemento.
model ItemPedidoComplemento {
  id            Int         @id @default(autoincrement())
  itemPedidoId  Int
  itemPedido    ItemPedido  @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)
  complementoId Int
  complemento   Complemento @relation(fields: [complementoId], references: [id])

  @@index([itemPedidoId])
}

/// Catálogo de proteínas do "Monte sua marmita" — gerenciado pelo admin.
model Proteina {
  id          Int                  @id @default(autoincrement())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome        String
  ativo       Boolean              @default(true)
  esgotado    Boolean              @default(false)
  /// "padrao" | "executiva" — proteínas executivas só aparecem ao montar a Marmita Executiva.
  tipo        String               @default("padrao")
  itensUsados ItemPedidoProteina[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([tenantId])
}

/// Catálogo de complementos do "Monte sua marmita" — gerenciado pelo admin.
model Complemento {
  id          Int                     @id @default(autoincrement())
  tenantId    String
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome        String
  ativo       Boolean                 @default(true)
  esgotado    Boolean                 @default(false)
  itensUsados ItemPedidoComplemento[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([tenantId])
}

/// Tamanhos fixos da marmita montada ("pequena" | "grande"). O id virou serial
/// (Int) pra poder ter tenantId na chave; `slug` preserva a string natural que
/// o frontend manda no checkout (index.html não pode ser alterado — ver Fase 1
/// verificação A) e nunca muda. Preço e quantidade de proteínas exigida editáveis pelo admin.
model TamanhoMarmita {
  id                Int          @id @default(autoincrement())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug              String // 'pequena' | 'grande'
  nome              String
  qtdProteinas      Int
  preco             Float
  /// Habilita esse tamanho de marmita no cardápio restrito do canal empresa.
  disponivelEmpresa Boolean      @default(false)
  itensPedido       ItemPedido[]
  updatedAt         DateTime     @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

/// Banners de promoção da Home. Gerenciados pelo admin — não são mais fixos no código do frontend.
model Banner {
  id        Int       @id @default(autoincrement())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  selo      String
  titulo    String
  descricao String
  ctaLabel  String
  ctaTipo   CtaBanner @default(CARDAPIO)
  /// Só usado quando ctaTipo = PRODUTO — pra onde o botão do banner leva.
  produtoId Int?
  produto   Produto?  @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  /// Caminho relativo do arquivo em /uploads/banners (ex: "banners/abc123.jpg") — nunca base64 no banco.
  foto      String?
  ativo     Boolean   @default(true)
  ordem     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
}

/// Mesa do salão. O pedido em aberto de uma mesa é o Pedido (tipo MESA) mais
/// recente com statusEntrega != ENTREGUE/CANCELADO — sem ponteiro denormalizado.
model Mesa {
  id          Int        @id @default(autoincrement())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero      Int
  lugares     Int        @default(4)
  status      StatusMesa @default(LIVRE)
  clienteNome String?
  /// Marca quando a mesa foi ocupada — usado pra calcular "aberta há X min".
  abertaEm    DateTime?
  pedidos     Pedido[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([tenantId, numero])
  @@index([tenantId])
}

/// Caixa do dia — aberto pelo admin no início do turno e fechado ao final.
/// totalVendas é calculado no fechamento (soma dos pedidos ENTREGUE no período).
model Caixa {
  id           Int       @id @default(autoincrement())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  valorInicial Float     @default(0)
  abertoEm     DateTime  @default(now())
  fechadoEm    DateTime?
  /// Calculado no fechamento: soma dos totais dos pedidos ENTREGUE criados entre abertoEm e fechadoEm.
  totalVendas  Float?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
}

/// Cliente corporativo (ex: construtora) que compra almoço em lote pros
/// funcionários. Cadastrado pelo admin — sem autocadastro. Login próprio
/// (login/senha, não email) e cota diária de pedidos configurável.
/// Não estava no escopo original de 22 models desta fase (feature adicionada
/// depois) — ganhou tenantId pelo mesmo motivo dos demais papéis de login:
/// é dado pertencente a uma loja especifica, nunca compartilhado entre tenants.
model Empresa {
  id                 Int                  @id @default(autoincrement())
  tenantId           String
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome               String
  login              String
  senha              String
  /// Limite de pedidos (marmitas) que essa empresa pode fazer por dia.
  cotaDiaria         Int                  @default(20)
  /// Preço fixo por marmita/pedido desta empresa — quando > 0, sobrepõe o preço
  /// calculado do catálogo (produto/tamanho) no pedido de empresa. 0 (padrão)
  /// mantém a precificação normal por item.
  valorMarmita       Float                @default(0)
  ativo              Boolean              @default(true)
  /// Marca a ultima troca de senha — o middleware rejeita tokens JWT emitidos
  /// antes dessa data (sessoes antigas nao ficam validas apos a troca).
  senhaAlteradaEm    DateTime?
  pedidos            Pedido[]
  funcionariosSalvos EmpresaFuncionario[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([tenantId, login])
  @@index([tenantId])
}

/// Nomes de funcionários salvos por uma empresa (cliente corporativo) pra
/// agilizar o pedido em lote — a empresa clica no nome em vez de digitar de
/// novo toda vez. Autossalvo quando um nome novo é usado num lote (ver
/// empresaPedidoController.criarLote).
model EmpresaFuncionario {
  id        Int      @id @default(autoincrement())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empresaId Int
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nome])
  @@index([tenantId])
  @@index([empresaId])
}

/// Motoboy/entregador que recebe pedidos distribuídos pelo admin.
/// Login próprio (email/senha) — mesmo esquema do Garcom, nunca acessa rotas de admin.
model Entregador {
  id              Int       @id @default(autoincrement())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome            String
  email           String
  senha           String
  ativo           Boolean   @default(true)
  /// Marca a ultima troca de senha — o middleware rejeita tokens JWT emitidos
  /// antes dessa data (sessoes antigas nao ficam validas apos a troca).
  senhaAlteradaEm DateTime?
  saldoZeradoEm   DateTime?
  pedidos         Pedido[]
  sangrias        SangriaEntregador[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model SangriaEntregador {
  id           Int        @id @default(autoincrement())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entregadorId Int
  entregador   Entregador @relation(fields: [entregadorId], references: [id], onDelete: Cascade)
  valor        Float
  createdAt    DateTime   @default(now())

  @@index([tenantId])
  @@index([entregadorId])
}

// ============================================================
// Fase 6A — Super Admin (dono da plataforma, subdomínio "super")
// ============================================================

/// Dono da plataforma. Model separado do Admin de propósito — nunca um campo
/// `role` no Admin, porque um bug de escalação de privilégio dentro de um
/// tenant não pode virar acesso a todos os clientes. `email` é único global
/// (não composto com tenantId — super admin não pertence a nenhum tenant).
model SuperAdmin {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  senha           String
  nome            String
  ativo           Boolean   @default(true)
  senhaAlteradaEm DateTime?
  createdAt       DateTime  @default(now())
}

/// Identidade visual de um tenant (cores, logo, fonte). Vive no admin do
/// tenant, mas a tela só é editável sob impersonation (req.impersonando) —
/// o dono do restaurante não muda cor sozinho.
model TenantBranding {
  id       Int    @id @default(autoincrement())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  logoUrl    String?
  faviconUrl String?

  // Cores Base
  corPrimaria        String @default("#C8102E")
  corSecundaria      String @default("#F5A623")
  corFundo           String @default("#FFFFFF")
  corFundoSecundaria String @default("#F7F7F7")
  corTexto           String @default("#1A1A1A")
  corDestaque        String @default("#F5A623")
  corSucesso         String @default("#16A34A")
  corAlerta          String @default("#F59E0B")
  corErro            String @default("#DC2626")

  // Botões
  botaoPrimarioFundo     String @default("#C8102E")
  botaoPrimarioTexto     String @default("#FFFFFF")
  botaoPrimarioBorda     String @default("#C8102E")
  botaoSecundarioFundo   String @default("#FFFFFF")
  botaoSecundarioTexto   String @default("#C8102E")
  botaoSecundarioBorda   String @default("#C8102E")
  botaoDesabilitadoFundo String @default("#E5E5E5")
  botaoDesabilitadoTexto String @default("#9CA3AF")

  // Cards e Blocos
  corCard                String @default("#FFFFFF")
  cardCorBorda           String @default("#E5E5E5")
  cardCorTitulo          String @default("#1A1A1A")
  cardCorTextoSecundario String @default("#6B7280")
  cardCorHover           String @default("#F5F5F5")
  cardRaioBorda          String @default("8px")

  // Navegação — Cabeçalho
  headerFundo           String @default("#FFFFFF")
  headerCorSaudacao     String @default("#1A1A1A")
  headerCorIconeUsuario String @default("#1A1A1A")
  headerCorLocalizacao  String @default("#6B7280")
  headerCorNotificacao  String @default("#C8102E")

  // Navegação — Barra inferior
  navInferiorFundo       String @default("#FFFFFF")
  navInferiorIconeNormal String @default("#9CA3AF")
  navInferiorIconeAtivo  String @default("#C8102E")
  navInferiorTextoNormal String @default("#9CA3AF")
  navInferiorTextoAtivo  String @default("#C8102E")

  fonteTitulo String @default("Inter")
  fonteTexto  String @default("Inter")

  updatedAt DateTime @updatedAt
}

/// Liga/desliga módulos por tenant (ex: um tenant sem salão não precisa da
/// feature "mesas"). Consumido por /api/config (Fase 6B esconde UI) — o
/// bloqueio de verdade nas rotas fica pra quando alguém precisar de fato.
model TenantFeature {
  id       Int     @id @default(autoincrement())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chave    String // 'empresa' | 'entregador' | 'mesas' | 'cupom' | 'marmita'
  ativo    Boolean @default(true)

  @@unique([tenantId, chave])
  @@index([tenantId])
}

/// Código de uso único (60s) que o super admin gera pra "entrar como" um
/// tenant. Nunca um token na URL — código de uso único resgatado via POST
/// evita vazar em log de proxy/histórico do navegador/header Referer.
/// Continua escopado por tenantId de propósito: um código gerado pro tenant A
/// não pode ser resgatado no subdomínio do tenant B, mesmo sabendo o valor.
model ImpersonacaoCodigo {
  id           String    @id @default(uuid())
  codigo       String    @unique
  superAdminId Int
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expiraEm     DateTime
  usadoEm      DateTime?
  criadoEm     DateTime  @default(now())

  @@index([tenantId])
}

/// Trilha de auditoria de quem operou como qual tenant e quando.
model LogImpersonacao {
  id           String    @id @default(uuid())
  superAdminId Int
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  iniciadoEm   DateTime  @default(now())
  encerradoEm  DateTime?
  ip           String?

  @@index([tenantId])
}
